# Pinned versions for the local dev cluster. Bump deliberately, one component per
# change, and note why in the commit message. Every pin was at least two weeks old
# when chosen (2026-11-14).

KIND_CLUSTER_NAME=agentory
# kind v0.33.0 is required; its default node image sets the Kubernetes version.
KIND_VERSION=v0.33.0

# Networking: Calico enforces NetworkPolicy (including egress), which the agent
# lockdown in ADR-0002 depends on.
CALICO_CHART_VERSION=v3.33.0

# Gateway API CRDs (standard channel) and agentgateway. agentgateway v1.4.1 is the
# newest real upstream release; the v2.2.x tags in cr.agentgateway.dev are not
# agentgateway releases (see AWS OAP gitops/addons/registry/gateway.yaml).
GATEWAY_API_VERSION=v1.5.0
AGENTGATEWAY_CHART_VERSION=v1.4.1

# LLM gateway.
BIFROST_CHART_VERSION=2.1.45
# The chart requires an explicit image tag; v2.3.1 is the chart's appVersion.
BIFROST_IMAGE_TAG=v2.3.1

# Tracing: OTel collector (contrib image) -> Jaeger for local development.
OTEL_COLLECTOR_CHART_VERSION=0.178.0
JAEGER_IMAGE=jaegertracing/jaeger:2.22.0

# Mock LLM runtime (stdlib-only server, code mounted from a ConfigMap).
MOCK_LLM_IMAGE=python:3.12.12-slim

# Smoke-test client image.
CURL_IMAGE=curlimages/curl:8.11.1
